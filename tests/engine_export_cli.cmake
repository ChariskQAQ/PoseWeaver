string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(work "${ROOT}/engine-cli-${suffix}")
file(MAKE_DIRECTORY "${work}/profile")
foreach(step IN ITEMS make_project export_project export_skeleton)
  if(step STREQUAL "make_project")
    set(args --demo "${SAMPLE}" --run json "${work}/input.rig.json")
  elseif(step STREQUAL "export_project")
    set(args "${work}/input.rig.json" --run engines "${work}/output.pwframes")
  else()
    set(args "${work}/input.rig.json" --run skeleton "${work}/output.pwskeleton")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "APPDATA=${work}/profile" "XDG_CONFIG_HOME=${work}/profile"
    "${PROGRAM}" ${args} WORKING_DIRECTORY "${work}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 12)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${step}: ${result}\n${output}\n${error}")
  endif()
endforeach()
file(READ "${work}/output.pwskeleton" skeleton)
string(JSON skeleton_image GET "${skeleton}" images 0 path)
string(JSON skeleton_animation GET "${skeleton}" animations 0 name)
if(NOT skeleton_animation STREQUAL "wave" OR NOT EXISTS "${work}/${skeleton_image}" OR IS_ABSOLUTE "${skeleton_image}")
  message(FATAL_ERROR "CLI skeleton export did not collect portable resources and animations")
endif()
file(READ "${work}/output.pwframes" manifest)
string(JSON format GET "${manifest}" format)
string(JSON name GET "${manifest}" animations 0 name)
string(JSON frames LENGTH "${manifest}" animations 0 frames)
string(JSON page GET "${manifest}" pages 0 file)
if(NOT format STREQUAL "poseweaver.frames" OR NOT name STREQUAL "wave" OR NOT frames EQUAL 30 OR NOT EXISTS "${work}/${page}")
  message(FATAL_ERROR "CLI did not load and export the supplied project")
endif()
file(REAL_PATH "${ROOT}" safe_root)
file(REAL_PATH "${work}" safe_work)
cmake_path(IS_PREFIX safe_root "${safe_work}" NORMALIZE inside)
if(NOT inside OR safe_work STREQUAL safe_root)
  message(FATAL_ERROR "Refusing to clean up outside the test root")
endif()
file(REMOVE_RECURSE "${safe_work}")
message(STATUS "CLI project-to-engine export passed")
