// Windows resources: the icon (GLFW_ICON is also picked up by GLFW for the window) and version info.
#pragma code_page(65001)
#include <winres.h>

GLFW_ICON ICON "@CMAKE_SOURCE_DIR@/assets/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "YuanLu"
            VALUE "FileDescription", "Poseweaver 2D skeletal animation editor"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Poseweaver"
            VALUE "OriginalFilename", "Poseweaver.exe"
            VALUE "ProductName", "Poseweaver"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
